{
  "name": "licensor",
  "description": "Rails application for license management",
  "keywords": [
    "dokku",
    "rails",
    "ruby"
  ],
  "scripts": {
    "dokku": {
      "postdeploy": "bundle exec rails db:migrate"
    }
  },
  "addons": [
    "dokku-postgres"
  ],
  "env": {
    "RAILS_ENV": {
      "description": "Rails environment",
      "value": "production"
    },
    "RAILS_SERVE_STATIC_FILES": {
      "description": "Enables serving static files",
      "value": "true"
    },
    "RAILS_LOG_TO_STDOUT": {
      "description": "Send logs to stdout for Dokku logging",
      "value": "true"
    },
    "SECRET_KEY_BASE": {
      "description": "A secret key for verifying the integrity of signed cookies",
      "generator": "secret"
    },
    "ADMIN_API_KEY": {
      "description": "API key for admin access",
      "required": true
    },
    "STRIPE_API_KEY": {
      "description": "Stripe API key",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Secret for verifying Stripe webhook signatures",
      "required": true
    },
    "ZAPIER_HOOK_URL": {
      "description": "Webhook URL for Zapier integration",
      "required": true
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS access key for S3",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS secret key for S3",
      "required": true
    },
    "AWS_REGION": {
      "description": "AWS region for S3",
      "required": true
    },
    "AWS_BUCKET": {
      "description": "AWS S3 bucket name",
      "required": true
    },
    "ACTION_MAILER_DELIVERY_METHOD": {
      "description": "Action Mailer delivery method (smtp or mailgun)",
      "value": "smtp"
    },
    "SMTP_ADDRESS": {
      "description": "SMTP server hostname (AWS SES: email-smtp.<region>.amazonaws.com)",
      "required": true
    },
    "SMTP_PORT": {
      "description": "SMTP server port",
      "value": "587"
    },
    "SMTP_USERNAME": {
      "description": "SMTP username",
      "required": true
    },
    "SMTP_PASSWORD": {
      "description": "SMTP password",
      "required": true
    },
    "SMTP_DOMAIN": {
      "description": "SMTP HELO domain",
      "required": true
    },
    "SMTP_AUTHENTICATION": {
      "description": "SMTP authentication mode",
      "value": "plain"
    },
    "SMTP_ENABLE_STARTTLS_AUTO": {
      "description": "Enable STARTTLS",
      "value": "true"
    }
  }
}
